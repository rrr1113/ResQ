{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WeatherApi": {
    "BaseAddress": "https://api.open-meteo.com/",
    "TimeoutSeconds": 30,
    "CacheExpirationMinutes": 30
  },
  "GeocodeApi": {
    "BaseAddress": "https://nominatim.openstreetmap.org/",
    "TimeoutSeconds": 30
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "YOUR_USERNAME",
    "Password": "YOUR_PASSWORD",
    "FromAddress": "resQ@gmail.com",
    "FromName": "ResQ",
    "UseSsl": true
  },
  "ApiKeySettings": {
    "ApiKey": ""
  },
  "RateLimitSettings": {
    "PermitLimit": 10,
    "WindowInSeconds": 150,
    "Apply": true
  },
  "AllowedHosts": "*"
}
